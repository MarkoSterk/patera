# Copy to .env (loaded by `patera dev` and `patera cli`) and fill in.

# Signs the JWT access tokens; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PATERA_SECRET_KEY=

# Externally reachable origin, used in exam QR codes. An https:// origin also
# makes the auth cookie Secure.
PATERA_PUBLIC_URL=http://localhost:3000

# Defaults to exams.sqlite3 next to this file.
# PATERA_EXAMS_DB__DATABASE_URI=sqlite+aiosqlite:///absolute/path/to/exams.sqlite3

# Enforce the schema's foreign keys (ON DELETE CASCADE / RESTRICT) on SQLite.
# On by default in app/configs.py; the schema relies on it.
PATERA_EXAMS_DB__SQLITE_FOREIGN_KEYS=true

# Lifetime of a sign-in, in seconds (default 8 hours).
# PATERA_JWT_LIFETIME_SECONDS=28800
