# Settings of the packaged program "Patera Notes", made by "patera cli desktop:env".
#
# desktop:package bundles this file into the program, which loads it at every
# start. Environment variables, then the installation's settings.env, win over
# it; the configuration class's defaults apply to whatever it leaves out.
# desktop:run loads it too, under the development .env.
#
# Anyone with a copy of the program can read this file: no passwords, keys or
# tokens. ${PATERA_DATA_DIR} is the user's data folder, for example
#   PATERA_MAIN_DB__DATABASE_URI=sqlite+aiosqlite:///${PATERA_DATA_DIR}/app.db
# The program runs in production mode unless PATERA_DEBUG says otherwise.
#
# Commented lines show the defaults: remove the # to change one. Lines without a
# value are required: desktop:package refuses to build until they have one.

# APP_NAME
# PATERA_APP_NAME="Patera Notes"

# VERSION
# PATERA_VERSION=1.0.0

# NOTES_DB.DATABASE_URI (required): Connection string for the database
PATERA_NOTES_DB__DATABASE_URI=sqlite+aiosqlite:///${PATERA_DATA_DIR}/notes.db
# NOTES_DB.DATABASE_SESSION_NAME: Name under which this database's request-bound
#   AsyncSession is stored in the request context (current_request.session(name)). Must
#   be unique per database when using multiple databases.
# PATERA_NOTES_DB__DATABASE_SESSION_NAME=session
# NOTES_DB.SHOW_SQL: If True, every executed SQL statement is logged to the console.
# PATERA_NOTES_DB__SHOW_SQL=false
# NOTES_DB.NICE_NAME: Name of the database for admin dashboard view. Defaults to db_name
#   variable.
# PATERA_NOTES_DB__NICE_NAME=
# NOTES_DB.EXPIRE_ON_COMMIT: Wether session should expire upon commit or not. Defaults
#   to False.
# PATERA_NOTES_DB__EXPIRE_ON_COMMIT=false
# NOTES_DB.AUTOFLUSH: Wether session should autoflush or not. Defaults to False.
# PATERA_NOTES_DB__AUTOFLUSH=false

# DESKTOP.INDEX_PAGE: Page the window opens: a path of the application, relative to
#   URL_PREFIX ('/', '/dashboard'), or an absolute URL.
# PATERA_DESKTOP__INDEX_PAGE=/
# DESKTOP.TITLE: Window title. Not set: the application's APP_NAME.
# PATERA_DESKTOP__TITLE=
# DESKTOP.WIDTH: Window width (logical pixels).
PATERA_DESKTOP__WIDTH=1100
# DESKTOP.HEIGHT: Window height (logical pixels).
# PATERA_DESKTOP__HEIGHT=720
# DESKTOP.MIN_WIDTH: The narrowest the user can make the window.
PATERA_DESKTOP__MIN_WIDTH=640
# DESKTOP.MIN_HEIGHT: The lowest the user can make the window.
PATERA_DESKTOP__MIN_HEIGHT=420
# DESKTOP.REMEMBER_GEOMETRY: Reopen the window with the size, position and maximized
#   state it had when it was closed (kept in the user's data folder). WIDTH, HEIGHT and
#   MAXIMIZED then apply only to the first start.
# PATERA_DESKTOP__REMEMBER_GEOMETRY=true
# DESKTOP.MAXIMIZED: Open the window maximized.
# PATERA_DESKTOP__MAXIMIZED=false
# DESKTOP.FULLSCREEN: Open the window in full screen.
# PATERA_DESKTOP__FULLSCREEN=false
# DESKTOP.RESIZABLE: The user can resize the window.
# PATERA_DESKTOP__RESIZABLE=true
# DESKTOP.ON_TOP: Keep the window above other windows.
# PATERA_DESKTOP__ON_TOP=false
# DESKTOP.CONFIRM_CLOSE: Ask the user to confirm before the window closes.
# PATERA_DESKTOP__CONFIRM_CLOSE=false
# DESKTOP.BACKGROUND_COLOR: Color shown before the page has loaded; set it to the page's
#   background to avoid a flash, for example in a dark design.
# PATERA_DESKTOP__BACKGROUND_COLOR="#FFFFFF"
# DESKTOP.TEXT_SELECT: The user can select (and copy) the page's text.
# PATERA_DESKTOP__TEXT_SELECT=true
# DESKTOP.ZOOMABLE: The user can zoom the page (Ctrl and +/-).
# PATERA_DESKTOP__ZOOMABLE=false
# DESKTOP.PERSIST_STORAGE: Keep cookies and local storage between starts, in the user's
#   data folder. Off: they are forgotten when the window closes, so for example every
#   start signs the user out.
# PATERA_DESKTOP__PERSIST_STORAGE=true
# DESKTOP.ICON: Icon file, relative to the application's root folder (.ico on Windows,
#   .icns on macOS, .png on Linux). Linux uses it for the window; on Windows and macOS
#   the window shows the executable's icon, which desktop:spec takes from this setting.
# PATERA_DESKTOP__ICON=
# DESKTOP.DEV_TOOLS: The web inspector, from the page's context menu. Not set: on for
#   desktop:run in dev mode and when DEBUG is on, off otherwise.
# PATERA_DESKTOP__DEV_TOOLS=
# DESKTOP.GUI: pywebview's GUI toolkit, for example 'qt' or 'gtk' on Linux. Not set:
#   pywebview chooses.
# PATERA_DESKTOP__GUI=
