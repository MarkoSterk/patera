"""JavaScript built-ins as exposed through Pyodide proxies.

Primitive strings, booleans and numbers convert to Python values. Collections
and objects remain JS proxies. These declarations do not implement JS objects.
"""

from collections.abc import Awaitable, Callable, Generator, Iterable, Iterator
from typing import Any, Generic, TypeVar, Self

T = TypeVar("T")
U = TypeVar("U")
K = TypeVar("K")
V = TypeVar("V")
Function = Callable[..., Any]

class ArrayBuffer:
    byteLength: int
    maxByteLength: int
    resizable: bool
    @classmethod
    def new(cls, byteLength: int) -> ArrayBuffer: ...
    def slice(self, begin: int, end: int = ...) -> ArrayBuffer: ...
    def resize(self, newLength: int) -> None: ...
    @staticmethod
    def isView(value: object) -> bool: ...

class SharedArrayBuffer:
    byteLength: int
    maxByteLength: int
    growable: bool
    @classmethod
    def new(cls, byteLength: int) -> SharedArrayBuffer: ...
    def slice(self, begin: int, end: int = ...) -> SharedArrayBuffer: ...
    def grow(self, newLength: int) -> None: ...

class _TypedArray(Generic[T]):
    buffer: ArrayBuffer | SharedArrayBuffer
    byteLength: int
    byteOffset: int
    length: int
    BYTES_PER_ELEMENT: int
    @classmethod
    def new(
        cls,
        source: int | Iterable[T] | ArrayBuffer | SharedArrayBuffer,
        byteOffset: int = ...,
        length: int = ...,
    ) -> Self: ...
    def __getitem__(self, index: int) -> T: ...
    def __setitem__(self, index: int, value: T) -> None: ...
    def __iter__(self) -> Iterator[T]: ...
    def __len__(self) -> int: ...
    def at(self, index: int) -> T | None: ...
    def set(self, source: Iterable[T], offset: int = ...) -> None: ...
    def fill(self, value: T, start: int = ..., end: int = ...) -> Self: ...
    def slice(self, start: int = ..., end: int = ...) -> Self: ...
    def subarray(self, begin: int = ..., end: int = ...) -> Self: ...
    def to_py(self) -> Any: ...

class Int8Array(_TypedArray[int]): ...
class Uint8Array(_TypedArray[int]): ...
class Uint8ClampedArray(_TypedArray[int]): ...
class Int16Array(_TypedArray[int]): ...
class Uint16Array(_TypedArray[int]): ...
class Int32Array(_TypedArray[int]): ...
class Uint32Array(_TypedArray[int]): ...
class BigInt64Array(_TypedArray[int]): ...
class BigUint64Array(_TypedArray[int]): ...
class Float32Array(_TypedArray[float]): ...
class Float64Array(_TypedArray[float]): ...

class DataView:
    buffer: ArrayBuffer | SharedArrayBuffer
    byteLength: int
    byteOffset: int
    @classmethod
    def new(
        cls,
        buffer: ArrayBuffer | SharedArrayBuffer,
        byteOffset: int = ...,
        byteLength: int = ...,
    ) -> DataView: ...
    def getInt8(self, byteOffset: int) -> int: ...
    def getUint8(self, byteOffset: int) -> int: ...
    def getInt16(self, byteOffset: int, littleEndian: bool = ...) -> int: ...
    def getUint16(self, byteOffset: int, littleEndian: bool = ...) -> int: ...
    def getInt32(self, byteOffset: int, littleEndian: bool = ...) -> int: ...
    def getUint32(self, byteOffset: int, littleEndian: bool = ...) -> int: ...
    def getFloat32(self, byteOffset: int, littleEndian: bool = ...) -> float: ...
    def getFloat64(self, byteOffset: int, littleEndian: bool = ...) -> float: ...
    def getBigInt64(self, byteOffset: int, littleEndian: bool = ...) -> int: ...
    def getBigUint64(self, byteOffset: int, littleEndian: bool = ...) -> int: ...
    def setInt8(self, byteOffset: int, value: int) -> None: ...
    def setUint8(self, byteOffset: int, value: int) -> None: ...
    def setInt16(
        self, byteOffset: int, value: int, littleEndian: bool = ...
    ) -> None: ...
    def setUint16(
        self, byteOffset: int, value: int, littleEndian: bool = ...
    ) -> None: ...
    def setInt32(
        self, byteOffset: int, value: int, littleEndian: bool = ...
    ) -> None: ...
    def setUint32(
        self, byteOffset: int, value: int, littleEndian: bool = ...
    ) -> None: ...
    def setFloat32(
        self, byteOffset: int, value: float, littleEndian: bool = ...
    ) -> None: ...
    def setFloat64(
        self, byteOffset: int, value: float, littleEndian: bool = ...
    ) -> None: ...
    def setBigInt64(
        self, byteOffset: int, value: int, littleEndian: bool = ...
    ) -> None: ...
    def setBigUint64(
        self, byteOffset: int, value: int, littleEndian: bool = ...
    ) -> None: ...

class Array(Generic[T]):
    length: int
    @classmethod
    def new(cls, *items: T) -> Array[T]: ...
    def __getitem__(self, index: int) -> T: ...
    def __setitem__(self, index: int, value: T) -> None: ...
    def __iter__(self) -> Iterator[T]: ...
    def __len__(self) -> int: ...
    def at(self, index: int) -> T | None: ...
    def push(self, *items: T) -> int: ...
    def pop(self) -> T | None: ...
    def shift(self) -> T | None: ...
    def unshift(self, *items: T) -> int: ...
    def includes(self, item: T, fromIndex: int = ...) -> bool: ...
    def indexOf(self, item: T, fromIndex: int = ...) -> int: ...
    def join(self, separator: str = ...) -> str: ...
    def slice(self, start: int = ..., end: int = ...) -> Array[T]: ...
    def splice(self, start: int, deleteCount: int = ..., *items: T) -> Array[T]: ...
    def map(self, callback: Callable[[T, int, Array[T]], U]) -> Array[U]: ...
    def filter(self, callback: Callable[[T, int, Array[T]], bool]) -> Array[T]: ...
    def forEach(self, callback: Callable[[T, int, Array[T]], object]) -> None: ...
    def to_py(self) -> list[T]: ...

class Map(Generic[K, V]):
    size: int
    @classmethod
    def new(cls, entries: Iterable[tuple[K, V]] = ...) -> Map[K, V]: ...
    def get(self, key: K) -> V | None: ...
    def set(self, key: K, value: V) -> Map[K, V]: ...
    def has(self, key: K) -> bool: ...
    def delete(self, key: K) -> bool: ...
    def clear(self) -> None: ...
    def keys(self) -> Iterator[K]: ...
    def values(self) -> Iterator[V]: ...
    def entries(self) -> Iterator[tuple[K, V]]: ...

class Set(Generic[T]):
    size: int
    @classmethod
    def new(cls, values: Iterable[T] = ...) -> Set[T]: ...
    def add(self, value: T) -> Set[T]: ...
    def has(self, value: T) -> bool: ...
    def delete(self, value: T) -> bool: ...
    def clear(self) -> None: ...
    def values(self) -> Iterator[T]: ...
    def entries(self) -> Iterator[tuple[T, T]]: ...

class Promise(Awaitable[T]):
    def __await__(self) -> Generator[Any, None, T]: ...
    def then(
        self,
        onFulfilled: Callable[[T], U | Awaitable[U]],
        onRejected: Callable[[Any], U | Awaitable[U]] = ...,
    ) -> Promise[U]: ...
    def catch(
        self, onRejected: Callable[[Any], U | Awaitable[U]]
    ) -> Promise[T | U]: ...
    def finally_(self, onFinally: Callable[[], object]) -> Promise[T]: ...
    @staticmethod
    def resolve(value: U | Awaitable[U]) -> Promise[U]: ...

class Date:
    @classmethod
    def new(cls, value: str | int | float = ...) -> Date: ...
    @staticmethod
    def now() -> float: ...
    @staticmethod
    def parse(value: str) -> float: ...
    def getTime(self) -> float: ...
    def getFullYear(self) -> int: ...
    def getMonth(self) -> int: ...
    def getDate(self) -> int: ...
    def getDay(self) -> int: ...
    def getHours(self) -> int: ...
    def getMinutes(self) -> int: ...
    def getSeconds(self) -> int: ...
    def toISOString(self) -> str: ...
    def toJSON(self) -> str | None: ...

class RegExp:
    source: str
    flags: str
    lastIndex: int
    @classmethod
    def new(cls, pattern: str, flags: str = ...) -> RegExp: ...
    def test(self, value: str) -> bool: ...
    def exec(self, value: str) -> Array[str | None] | None: ...

class JSON:
    @staticmethod
    def parse(text: str) -> Any: ...
    @staticmethod
    def stringify(
        value: Any, replacer: Any = ..., space: str | int = ...
    ) -> str | None: ...
